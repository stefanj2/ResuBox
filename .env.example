# ResuBox — environment variables
# Kopieer naar .env.local en vul echte waarden in. Commit .env.local NOOIT.

# --- Database (Neon Postgres via Vercel) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- E-mail (Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@resubox.com"
FROM_EMAIL_INCASSO="Incasso Afdeling <incasso@resubox.com>"
# Kill-switch voor ALLE uitgaande mail (factuur, herinneringen, WIK, incasso, betaalbevestiging).
# Standaard/afwezig = "false" = er gaat NIETS uit. Zet expliciet op "true" om te verzenden.
EMAILS_ENABLED="false"

# --- SMS (Bird.com / legacy MessageBird) ---
# Afwezig = SMS gestubt (alleen console-log, geen verzending).
BIRD_API_KEY=""
BIRD_ORIGINATOR="ResuBox"

# --- Justus Collect (incasso) ---
# Afwezig = incasso gestubt; orders belanden in incasso_manual_review.
JUSTUS_API_KEY=""

# --- Admin auth ---
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# --- Overig ---
NEXT_PUBLIC_SITE_URL="https://resubox.com"
CRON_SECRET=""
